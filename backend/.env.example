# TDX API 憑證（僅後端使用，前端永遠不會接觸這些值）
# 申請方式：https://tdx.transportdata.tw/
TDX_CLIENT_ID=your_tdx_client_id
TDX_CLIENT_SECRET=your_tdx_client_secret

# 是否啟用真實 TDX 串接（第一版固定為 false，僅使用模擬資料）
USE_TDX=false

# 資料庫位置
DATABASE_URL=sqlite:///./movego.db

# CORS 允許來源（開發時的前端網址）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
